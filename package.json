{
  "name": "wayfile-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "File-based agent framework: fast deterministic routes, focused models, bounded tool harnesses.",
  "type": "module",
  "main": "./packages/wayfile/src/index.js",
  "exports": {
    ".": "./packages/wayfile/src/index.js",
    "./harness": "./packages/wayfile/src/harness.js",
    "./tools": "./packages/wayfile/src/tools.js",
    "./coding": "./apps/waycode/src/coding.js"
  },
  "bin": {
    "wayfile": "packages/wayfile/bin/wayfile.js",
    "waycode": "apps/waycode/bin/waycode.js"
  },
  "files": [
    "packages/wayfile",
    "apps/waycode",
    "scripts",
    "README.md",
    "docs/CODING.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "wayfile": "node packages/wayfile/bin/wayfile.js",
    "waycode": "node apps/waycode/bin/waycode.js",
    "setup-agent": "node scripts/setup-agent.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "wayfile": "file:packages/wayfile",
    "waycode": "file:apps/waycode"
  }
}
