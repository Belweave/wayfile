{
  "name": "wayfile-monorepo",
  "version": "0.2.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "wayfile-monorepo",
      "version": "0.2.0",
      "license": "UNLICENSED",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "dependencies": {
        "waycode": "file:apps/waycode",
        "wayfile": "file:packages/wayfile"
      },
      "bin": {
        "waycode": "apps/waycode/bin/waycode.js",
        "wayfile": "packages/wayfile/bin/wayfile.js"
      },
      "engines": {
        "node": ">=20.6.0"
      }
    },
    "apps/waycode": {
      "version": "0.2.0",
      "license": "UNLICENSED",
      "dependencies": {
        "wayfile": "file:../../packages/wayfile"
      },
      "bin": {
        "waycode": "bin/waycode.js"
      },
      "engines": {
        "node": ">=20.6.0"
      }
    },
    "node_modules/waycode": {
      "resolved": "apps/waycode",
      "link": true
    },
    "node_modules/wayfile": {
      "resolved": "packages/wayfile",
      "link": true
    },
    "packages/wayfile": {
      "version": "0.2.0",
      "license": "UNLICENSED",
      "bin": {
        "wayfile": "bin/wayfile.js"
      },
      "engines": {
        "node": ">=20.6.0"
      }
    }
  }
}
